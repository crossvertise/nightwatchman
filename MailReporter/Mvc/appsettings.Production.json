{
  "AzureFunctions": {
    "ServiceBusNamespaceResourceId": "/subscriptions/569238d4-4a0c-4a81-bc37-9eb6d670e046/resourceGroups/crossvertise-live/providers/Microsoft.ServiceBus/namespaces/xv-servicebus-live",
    "Monitors": [
      { "Name": "Mailer", "FunctionApp": "xv-functions-mailer-live-v2", "Queue": "xv-mailer-queue" },
      { "Name": "CRM integration", "FunctionApp": "xv-functions-crm-live-v2", "Topic": "xv-crm-integration-topic", "Subscription": "all-messages" },
      { "Name": "Domain events: Artificial Manager", "FunctionApp": "xv-functions-domain-events-live", "Topic": "domain-events", "Subscription": "domain-events-artificial-manager" },
      { "Name": "Domain events: Audit", "FunctionApp": "xv-functions-domain-events-live", "Topic": "domain-events", "Subscription": "domain-events-audit" },
      { "Name": "External data management", "FunctionApp": "xv-functions-external-data-management-live", "Topic": "external-data-management", "Subscription": "external-data-manager" },
      { "Name": "JvB motif instructions", "FunctionApp": "xv-functions-jvb-live-v2", "Queue": "xv-jvb-motive-instruction-queue" },
      { "Name": "OOH planner optimizer", "FunctionApp": "xv-functions-optimizer-v2-live", "Queue": "xv-optimize-queue-live" },
      { "Name": "Order sub-status sync", "FunctionApp": "xv-functions-order-substatus-live", "Queue": "xv-order-substatus-sync-queue" },
      { "Name": "AdOps report notifier", "FunctionApp": "xv-functions-adops-report-notifier-live", "Queue": "xv-adops-report-notifier" }
    ]
  },
  "HttpHealth": {
    "Monitors": [
      {
        "Name": "Payment Health Live",
        "JobName": "Payment Health Live",
        "Url": "https://market.crossvertise.com/api-fd/v1/internal/monitoring/payment-health",
        "Scope": "api://5ca23a36-a02c-420d-8386-ff0a04a3dcab/.default"
      }
    ]
  },
  "LogQueryHealth": {
    "Monitors": [
      {
        "Name": "Checkout API Errors Live",
        "JobName": "Checkout API Errors Live",
        "WorkspaceId": "869913e8-135b-4cb7-b45f-69126c020a9f",
        "Timespan": "PT30M",
        "Query": "AppRequests | where AppRoleName startswith \"xv-api-live\" | where toint(ResultCode) >= 500 | where Url has \"/payment\" or Url has \"/checkout\" or Url has \"/cart\" or Url has \"/order\" or Name has \"ayment\" or Name has \"heckout\" | summarize errors = tolong(coalesce(sum(ItemCount), 0)), routes = make_set(Name, 5) | extend warnings = 0, message = iff(errors == 0, \"No checkout 5xx in the window\", strcat(tostring(errors), \" x 5xx on checkout routes: \", strcat_array(routes, \", \"))) | project errors, warnings, message"
      }
    ]
  },
  "Alerting": {
    "Enabled": true,
    "ImmediateJobs": [ "Payment Health Live", "Checkout API Errors Live" ],
    "DashboardUrl": "https://xv-nightwatchman-live.azurewebsites.net/Dashboard"
  }
}
