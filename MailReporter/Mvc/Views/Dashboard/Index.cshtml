@model Mvc.Models.DashboardViewModel
@{
    ViewData["Title"] = "Index";
}
<h2>Job Overwiew</h2>
<div class="row">
@foreach(var job in Model.Jobs) {
    var status = job.LastStatus == DomainModel.JobExecutionStatus.Error || job.IsDue
        ? "panel-danger"
        : job.LastStatus == DomainModel.JobExecutionStatus.Success
            ? "panel-success"
            : "panel-default";
    <div class="col-lg-3 col-md-3 col-sm-6">
        <div class="panel @status">
            <div class="panel-heading">@job.Job.Name</div>
            <div class="panel-body">
                Last run: @job.LastRun <br />
                Next run: @job.NextRun <br />
                Is Due: @job.IsDue
                @{
                    var lastExecution = job.LastExecutions?.FirstOrDefault();
                }
                @if (lastExecution?.Status == DomainModel.JobExecutionStatus.Error)
                {
                    var issues = BusinessLogic.Implementations.HealthIssueReader.Parse(lastExecution.ErrorSummary);
                    var host = BusinessLogic.Implementations.HealthIssueReader.HostFor(Model.HttpHealth, job.Job.Name);
                    <div class="small" style="margin-top:6px"><strong>@lastExecution.OriginalSubject</strong></div>
                    @if (issues.Count > 0)
                    {
                        <ul class="small" style="padding-left:16px;margin:4px 0 0">
                        @foreach (var issue in issues.Take(BusinessLogic.Implementations.HealthIssueReader.MaxLines))
                        {
                            <li>
                                @BusinessLogic.Implementations.HealthIssueReader.DescribeReason(issue.Reason)
                                @if (!string.IsNullOrWhiteSpace(issue.Provider)) { <text> · @issue.Provider</text> }
                                @if (issue.PaymentId.HasValue) { <text> · payment @issue.PaymentId</text> }
                                @if (issue.OrderId.HasValue)
                                {
                                    if (host != null)
                                    {
                                        <text> · order </text><a href="@BusinessLogic.Implementations.HealthIssueReader.OrderUrl(host, issue.OrderId.Value)" target="_blank" rel="noopener">@issue.OrderId</a>
                                    }
                                    else
                                    {
                                        <text> · order @issue.OrderId</text>
                                    }
                                }
                                @if (issue.SinceUtc.HasValue) { <text> · since @issue.SinceUtc.Value.ToString("dd.MM. HH:mm") UTC</text> }
                            </li>
                        }
                        @if (issues.Count > BusinessLogic.Implementations.HealthIssueReader.MaxLines)
                        {
                            <li>… and @(issues.Count - BusinessLogic.Implementations.HealthIssueReader.MaxLines) more</li>
                        }
                        </ul>
                    }
                }
            </div>

            <div class="panel-footer @status">Status: <strong>@job.LastStatus</strong></div>
        </div>
    </div>
}
</div>
@if (Model.Functions.Count > 0) {
<h2>Azure Functions</h2>
<p class="text-muted">
    Stuck: messages are waiting and nothing was completed in the last @Model.Functions[0].WindowMinutes minutes, i.e. the function is not running.
</p>
<div class="row">
@foreach(var function in Model.Functions) {
    var status = function.Error != null
        ? "panel-default"
        : function.IsStuck
            ? "panel-danger"
            : "panel-success";
    var label = function.Error != null ? "Unknown" : function.IsStuck ? "Stuck" : "OK";
    <div class="col-lg-3 col-md-3 col-sm-6">
        <div class="panel @status">
            <div class="panel-heading" title="@function.Monitor.FunctionApp">@function.Monitor.Name</div>
            <div class="panel-body">
                Reads: @function.Monitor.Source <br />
                Waiting: @function.WaitingMessages <br />
                Completed (@function.WindowMinutes min): @function.CompletedMessages <br />
                Dead letters: @function.DeadLetteredMessages
                @if (function.Error != null) {
                    <br /><small class="text-muted">@function.Error</small>
                }
            </div>

            <div class="panel-footer @status">Status: <strong>@label</strong></div>
        </div>
    </div>
}
</div>
}
